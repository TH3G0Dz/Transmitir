NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DOMAIN=share.example.com
SERVER_PUBLIC_IP=203.0.113.10
# Para um proxy local confiável, use o número exato de saltos (por exemplo, 1).
TRUST_PROXY_HOPS=0
# Quick Tunnels são temporários; habilite somente ao usar cloudflared local.
ALLOW_QUICK_TUNNEL=false
# Prazo de inatividade; enquanto a sala estiver conectada, ele é renovado automaticamente.
ROOM_TTL_SECONDS=21600
MAX_VIEWERS=4
MAX_ROOMS=500
MAX_CONNECTIONS_PER_IP=20
MAX_MESSAGE_BYTES=65536
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MESSAGES=120

# STUN público para desenvolvimento. Em produção, avalie disponibilidade e privacidade.
STUN_URLS=stun:stun.l.google.com:19302

# TURN é opcional para iniciar, mas necessário para melhorar a conectividade em redes restritas.
# Use credenciais coturn REST com o mesmo segredo configurado no coturn.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
